{
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Otter"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "description": "Open the Otter menu",
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      }
    },
    "quick-save": {
      "description": "Quick save to Otter",
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      }
    },
    "read-later": {
      "description": "Read later in Otter"
    }
  },
  "content_scripts": [
    {
      "js": ["contentScript.js"],
      "matches": ["<all_urls>"],
      "run_at": "document_idle"
    }
  ],
  "description": "A universal browser extension for Otter bookmarks",
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon_16.png",
    "32": "icons/icon_32.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "manifest_version": 3,
  "name": "Otter",
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "system.display",
    "tabs",
    "webNavigation"
  ],
  "version": "0.3.0"
}

{
  "name": "@mrmartineau/otter",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://github.com/mrmartineau/otter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrmartineau/otter.git"
  },
  "type": "module",
  "scripts": {
    "check": "oxlint --fix && oxfmt",
    "chrome-extension:build": "pnpm --filter=@mrmartineau/otter-chrome-extension run build",
    "preview": "vite preview",
    "tui:build": "pnpm --filter=@mrmartineau/otter-tui run build",
    "tui:dev": "pnpm --filter=@mrmartineau/otter-tui run dev",
    "type-check": "tsc --noEmit",
    "web:build": "pnpm --filter=@mrmartineau/otter-web run build",
    "web:dev": "pnpm --filter=@mrmartineau/otter-web run dev",
    "web:test": "pnpm --filter=@mrmartineau/otter-web run test"
  },
  "devDependencies": {
    "@mrmartineau/kit": "catalog:",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "semantic-release": "^25.0.3",
    "semantic-release-monorepo": "^8.0.2"
  },
  "packageManager": "pnpm@12.4.2"
}
